{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FairLens",
  "version": "0.1.0",
  "identifier": "com.fairlens.desktop",
  "build": {
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm --filter @fairlens/desktop dev",
    "beforeBuildCommand": "pnpm --filter @fairlens/desktop build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FairLens",
        "width": 420,
        "height": 520,
        "minWidth": 420,
        "minHeight": 520,
        "decorations": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https:; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"]
  }
}
